{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordLoop Candidate Sentences",
  "type": "object",
  "required": ["courseId", "candidateCountPerSlot", "slots", "generationReview"],
  "properties": {
    "courseId": {"type": "string"},
    "candidateCountPerSlot": {"type": "integer", "minimum": 1},
    "slots": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["slot", "options"],
        "properties": {
          "slot": {"type": "integer", "minimum": 1, "maximum": 16},
          "generationWarning": {"type": ["string", "null"]},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "candidateId", "text", "translation", "usedChunks",
                "estimatedDifficulty", "difficultyFactors", "wordCount",
                "clauseCount", "informationUnitCount", "realWorldUseExplanation"
              ],
              "properties": {
                "candidateId": {"type": "string"},
                "text": {"type": "string"},
                "translation": {"type": "string"},
                "usedChunks": {"type": "array", "items": {"type": "string"}},
                "estimatedDifficulty": {"type": "string"},
                "difficultyFactors": {"type": "array", "items": {"type": "string"}},
                "wordCount": {"type": "integer", "minimum": 1},
                "clauseCount": {"type": "integer", "minimum": 1},
                "informationUnitCount": {"type": "integer", "minimum": 1},
                "realWorldUseExplanation": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "generationReview": {
      "type": "object",
      "required": ["coverageComplete", "warnings"],
      "properties": {
        "coverageComplete": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
