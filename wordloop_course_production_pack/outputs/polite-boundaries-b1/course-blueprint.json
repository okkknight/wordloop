  "courseBrief": {
    "courseType": "communication_skill",
    "targetLevel": "B1",
    "learnerOutcome": "学习者能够先认可对方的请求，再说明自己当前可承担的范围，并提出明确、可执行的替代方案。",
    "communicationGoals": [
      "用简洁自然的方式表达愿意合作而非立刻回避。",
      "说明时间、精力或优先级限制，不作过度解释。",
      "提出延后、缩小范围、换一种协作方式等替代方案。",
      "在对方继续请求时保持礼貌且明确的立场。"
    ],
    "coreChunks": [
      "I'd love to, but",
      "I don't have the bandwidth to",
      "Could we",
      "I can ..., but I can't ..."
    ],
    "supportingVocabulary": [
      "right now",
      "this week",
      "take on",
      "deadline",
      "prioritize",
      "reschedule",
      "help with",
      "commit to"
    ],
    "contentBoundaries": [
      "不教授法律、合同、医疗或心理健康建议。",
      "不要求解释私人细节，也不把道歉作为每句的必要组成部分。",
      "不围绕单一职场角色、公司流程或人际冲突剧情。",
      "不把拒绝写成攻击性、冷漠或被动攻击的语气。"
    ],
    "realWorldContexts": [
      "同事临时增加任务时。",
      "朋友邀请或请人帮忙时。",
      "安排会议、项目协作或家庭分工时。",
      "需要调整承诺范围或截止时间时。"
    ]
